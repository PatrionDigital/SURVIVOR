# ===========================================
# Farcaster Survivors - Environment Variables
# ===========================================

# ===========================================
# Frontend (apps/web)
# ===========================================

# Base L2 RPC URL
VITE_BASE_RPC_URL=https://mainnet.base.org
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Contract Addresses (update after deployment)
VITE_VSC_TOKEN_ADDRESS=
VITE_VSC_BONDING_CURVE_ADDRESS=

# Gear Token Addresses
VITE_WEAPON_TOKEN_ADDRESS=
VITE_ARMOR_TOKEN_ADDRESS=
VITE_POWER_TOKEN_ADDRESS=
VITE_GLOVES_TOKEN_ADDRESS=
VITE_AMULET_TOKEN_ADDRESS=
VITE_BOOTS_TOKEN_ADDRESS=

# Gear-VSC Bonding Curve Addresses
VITE_WEAPON_CURVE_ADDRESS=
VITE_ARMOR_CURVE_ADDRESS=
VITE_POWER_CURVE_ADDRESS=
VITE_GLOVES_CURVE_ADDRESS=
VITE_AMULET_CURVE_ADDRESS=
VITE_BOOTS_CURVE_ADDRESS=

# Staking & Rewards (future)
VITE_GEAR_STAKING_ADDRESS=
VITE_REWARD_DISTRIBUTOR_ADDRESS=

# API URL
VITE_API_URL=http://localhost:3001

# WalletConnect Project ID
VITE_WALLETCONNECT_PROJECT_ID=

# Farcaster Mini App
VITE_FARCASTER_FRAME_URL=

# ===========================================
# Backend (apps/api)
# ===========================================

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
API_URL=http://localhost:3001

# Database - Local Docker (default for development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/survivor

# Database - Supabase (for production/staging)
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis - Local Docker (default for development)
REDIS_HOST=localhost
REDIS_PORT=6379

# Redis - Upstash (for production/staging)
# REDIS_URL=redis://default:[password]@[region].upstash.io:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Farcaster
FARCASTER_HUB_URL=https://hub.farcaster.xyz
NEYNAR_API_KEY=

# Reward Signing
REWARD_SIGNER_PRIVATE_KEY=

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ===========================================
# Smart Contracts (packages/contracts)
# ===========================================

# Deployer Private Key (NEVER commit real key)
DEPLOYER_PRIVATE_KEY=

# RPC URLs
BASE_MAINNET_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Block Explorers
BASESCAN_API_KEY=

# Treasury Addresses
TREASURY_ADDRESS=
BURN_ADDRESS=
