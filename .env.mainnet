# ===========================================
# Farcaster Survivors - Base Mainnet Production
# ===========================================
# Copy this to .env and fill in secrets before deploying.
# DO NOT commit secrets. This file contains only public addresses and defaults.
#
# CRITICAL: Use a hardware wallet or multisig for all mainnet keys.
# CRITICAL: Never reuse testnet keys on mainnet.

# ===========================================
# Frontend (apps/web) — set in Vercel dashboard
# ===========================================

VITE_USE_ANVIL=false
VITE_BASE_RPC_URL=https://mainnet.base.org
VITE_CHAIN_ID=8453

# Contract addresses (update after mainnet deployment)
VITE_VSC_TOKEN_ADDRESS=
VITE_WEAPON_TOKEN_ADDRESS=
VITE_ARMOR_TOKEN_ADDRESS=
VITE_POWER_TOKEN_ADDRESS=
VITE_GLOVES_TOKEN_ADDRESS=
VITE_AMULET_TOKEN_ADDRESS=
VITE_BOOTS_TOKEN_ADDRESS=

VITE_WEAPON_CURVE_ADDRESS=
VITE_ARMOR_CURVE_ADDRESS=
VITE_POWER_CURVE_ADDRESS=
VITE_GLOVES_CURVE_ADDRESS=
VITE_AMULET_CURVE_ADDRESS=
VITE_BOOTS_CURVE_ADDRESS=

VITE_GEAR_STAKING_ADDRESS=
VITE_REWARD_DISTRIBUTOR_ADDRESS=

VITE_API_URL=https://api.farcastersurvivors.game
VITE_WALLETCONNECT_PROJECT_ID=
VITE_FARCASTER_FRAME_URL=

# ===========================================
# Backend (apps/api) — set in Railway dashboard
# ===========================================

PORT=3001
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=warn
CORS_ORIGIN=https://farcastersurvivors.game

# Database (Supabase Production)
# DATABASE_URL=postgresql://...
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (Upstash Production)
# REDIS_URL=redis://...

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Farcaster
FARCASTER_HUB_URL=https://hub.farcaster.xyz
NEYNAR_API_KEY=
FARCASTER_APP_FID=
FARCASTER_APP_MNEMONIC=

# Reward Signing (USE HARDWARE WALLET / MULTISIG)
REWARD_SIGNER_PRIVATE_KEY=

# Rate Limiting (tighter for production)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Monitoring
SENTRY_DSN=

# ===========================================
# Smart Contracts — used by deploy scripts
# ===========================================

BASE_MAINNET_RPC_URL=https://mainnet.base.org
BASESCAN_API_KEY=

# Deployer (USE HARDWARE WALLET — never store mainnet keys in .env)
DEPLOYER_PRIVATE_KEY=

# Allocation addresses (MUST be multisig or vesting contracts)
TREASURY_ADDRESS=
EMISSIONS_ADDRESS=
TEAM_ADDRESS=
LIQUIDITY_ADDRESS=
AIRDROP_ADDRESS=
