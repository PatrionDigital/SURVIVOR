# ===========================================
# Farcaster Survivors - Base Sepolia Testnet
# ===========================================
# Copy this to .env and fill in secrets before deploying.
# DO NOT commit secrets. This file contains only public addresses and defaults.

# ===========================================
# Frontend (apps/web) — set in Vercel dashboard
# ===========================================

VITE_USE_ANVIL=false
VITE_BASE_RPC_URL=https://sepolia.base.org
VITE_CHAIN_ID=84532

# Contract addresses (update after running scripts/deploy-testnet.sh)
VITE_VSC_TOKEN_ADDRESS=
VITE_WEAPON_TOKEN_ADDRESS=
VITE_ARMOR_TOKEN_ADDRESS=
VITE_POWER_TOKEN_ADDRESS=
VITE_GLOVES_TOKEN_ADDRESS=
VITE_AMULET_TOKEN_ADDRESS=
VITE_BOOTS_TOKEN_ADDRESS=

VITE_WEAPON_CURVE_ADDRESS=
VITE_ARMOR_CURVE_ADDRESS=
VITE_POWER_CURVE_ADDRESS=
VITE_GLOVES_CURVE_ADDRESS=
VITE_AMULET_CURVE_ADDRESS=
VITE_BOOTS_CURVE_ADDRESS=

VITE_GEAR_STAKING_ADDRESS=
VITE_REWARD_DISTRIBUTOR_ADDRESS=

VITE_API_URL=https://survivor-api-staging.up.railway.app
VITE_WALLETCONNECT_PROJECT_ID=
VITE_FARCASTER_FRAME_URL=

# ===========================================
# Backend (apps/api) — set in Railway dashboard
# ===========================================

PORT=3001
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGIN=https://survivor-testnet.vercel.app

# Database (Supabase)
# DATABASE_URL=postgresql://...
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (Upstash)
# REDIS_URL=redis://...

# JWT (generate a strong secret)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Farcaster
FARCASTER_HUB_URL=https://hub.farcaster.xyz
NEYNAR_API_KEY=

# Reward Signing (generate a test key — NOT a real key with funds)
REWARD_SIGNER_PRIVATE_KEY=

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ===========================================
# Smart Contracts — used by deploy scripts
# ===========================================

BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=

# Deployer (test wallet only — fund with Sepolia ETH faucet)
DEPLOYER_PRIVATE_KEY=

# Allocation addresses (use test wallets for testnet)
TREASURY_ADDRESS=
EMISSIONS_ADDRESS=
TEAM_ADDRESS=
LIQUIDITY_ADDRESS=
AIRDROP_ADDRESS=
