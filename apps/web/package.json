    "@farcaster/miniapp-sdk": "^0.2.2",
    "@farcaster/miniapp-wagmi-connector": "^1.1.0",
    "@tanstack/react-query": "^5.62.0",
    "pixi.js": "^8.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.0",
    "viem": "^2.21.0",
    "wagmi": "^2.14.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@survivor/config": "workspace:*",
    "@survivor/sdk": "workspace:*",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
